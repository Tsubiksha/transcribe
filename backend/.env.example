DATABASE_URL=sqlite:///./app.db
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500
ALLOWED_EXTENSIONS=mp3,wav,m4a,aac,flac,mp4,mov,mkv,webm
CHROMA_PERSIST_PATH=chroma_storage
CHROMA_COLLECTION_NAME=video_transcripts
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
FFMPEG_LOCATION=
YOUTUBE_AUDIO_QUALITY=96
YOUTUBE_AUDIO_FORMAT=worstaudio[abr<=64]/worstaudio/bestaudio
YOUTUBE_TRANSCODE_AUDIO=false
YOUTUBE_CAPTION_LANGS=["ta.*","ta","en.*","en"]
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=2
WHISPER_BEAM_SIZE=1
WHISPER_PREPARE_AUDIO=true
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_VAD_SPEECH_PAD_MS=200
CHUNK_DURATION_SECONDS=90
CHUNK_OVERLAP_SECONDS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
