FFMPEG_LOCATION=C:\Users\Subiksha\Downloads\ffmpeg-8.1.1-essentials_build\ffmpeg-8.1.1-essentials_build\bin
YOUTUBE_AUDIO_QUALITY=96
YOUTUBE_AUDIO_FORMAT=worstaudio[abr<=64]/worstaudio/bestaudio
YOUTUBE_TRANSCODE_AUDIO=false
YOUTUBE_CAPTION_LANGS=["ta.*","ta","en.*","en","all","-live_chat"]
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CONCURRENCY=3
EMBEDDING_WRITE_BATCH_SIZE=8
EMBEDDING_LOG_EVERY=25
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=2
WHISPER_BEAM_SIZE=1
WHISPER_PREPARE_AUDIO=true
WHISPER_VAD_MIN_SILENCE_MS=500
WHISPER_VAD_SPEECH_PAD_MS=200
CHUNK_DURATION_SECONDS=90
CHUNK_OVERLAP_SECONDS=5
CHUNK_CONVERSATIONAL_TARGET_MAX=1100
CHUNK_CONVERSATIONAL_OVERLAP=120
